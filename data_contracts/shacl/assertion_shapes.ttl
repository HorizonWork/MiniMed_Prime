@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix kg: <https://example.org/minimed/> .

kg:AssertionShape a sh:NodeShape ;
    sh:targetClass kg:Assertion ;
    sh:property [ sh:path kg:assertion_id ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path kg:subject_id ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path kg:predicate ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path kg:object_id ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path kg:confidence ; sh:datatype xsd:double ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] .
