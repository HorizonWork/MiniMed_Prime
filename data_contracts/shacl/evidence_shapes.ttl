@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix kg: <https://example.org/minimed/> .

kg:EvidenceShape a sh:NodeShape ;
    sh:targetClass kg:EvidenceSpan ;
    sh:property [ sh:path kg:evidence_id ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path kg:doc_id ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path kg:text ; sh:datatype xsd:string ; sh:minCount 1 ] .
